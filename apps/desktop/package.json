{
  "name": "@meetapp/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "start": "node scripts/electron.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "pnpm --filter @meetapp/web build && node scripts/build.ts && electron-builder --config electron-builder.config.ts"
  },
  "dependencies": {
    "@sentry/electron": "^8.1.0"
  },
  "devDependencies": {
    "@meetapp/config": "workspace:*",
    "@meetapp/contracts": "workspace:*",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^44.10.1",
    "electron-builder": "26.18.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "productName": "MeetApp"
}
