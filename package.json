{
  "name": "meetapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "preflight": "node tools/preflight.mjs",
    "dev": "node tools/preflight.mjs && node tools/dev.ts",
    "dev:apps": "turbo run dev",
    "dev:stop": "docker compose -f infra/docker-compose.yml --env-file .env stop",
    "seed": "node tools/seed.ts add",
    "seed:clear": "node tools/seed.ts clear",
    "flag": "node tools/flag.ts",
    "storage:test": "node tools/storage-test.ts",
    "email:test": "node tools/email-test.ts",
    "test": "vitest run",
    "test:integration": "VITEST_INTEGRATION=1 vitest run infra packages apps",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs .",
    "check:unused": "knip --no-progress",
    "check:duplication": "jscpd .",
    "check:structure": "node tools/check-structure.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:architecture && pnpm check:unused && pnpm check:duplication && pnpm check:structure"
  },
  "devDependencies": {
    "@meetapp/config": "workspace:*",
    "@meetapp/db": "workspace:*",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "acorn": "^8.19.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "6.0.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,jsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": "prettier --write"
  }
}
