# MeetApp settings for running everything on this computer.
# `pnpm dev` copies this file to .env the first time. .env is never committed (it is in .gitignore).
# All values below are for local development only. They are not real secrets and only work on
# this computer, because every service listens on 127.0.0.1. Never reuse them online.
# Every setting needs only free software; no paid account is needed (AC-F00-06).

# ---------- Backend (apps/api) ----------
# development | test | production
NODE_ENV=development
# Address the backend listens on. 127.0.0.1 = only this computer can connect.
API_HOST=127.0.0.1
API_PORT=3000

# ---------- Database: PostgreSQL with pgvector ----------
POSTGRES_USER=meetapp
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=meetapp
# Change if another program (e.g. a local PostgreSQL) already uses 5432.
POSTGRES_PORT=5432

# ---------- Cache and job queue: Redis ----------
REDIS_PORT=6379

# ---------- Call server: LiveKit ----------
# Media also uses 7881 (TCP) and 7882 (UDP); those two are fixed in infra/livekit.yaml.
LIVEKIT_PORT=7880
# Key pair the backend uses to create meeting tokens. Local-only values.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local_dev_livekit_secret_change_me_online

# ---------- File storage: RustFS (S3-compatible, replaces MinIO, decision D035) ----------
# S3 API port and the web file browser port (http://127.0.0.1:9001).
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Login for the storage service and its file browser. Local-only values.
STORAGE_ACCESS_KEY=meetapp
STORAGE_SECRET_KEY=local_dev_storage_password
# The bucket (folder) the app stores files in; created automatically.
STORAGE_BUCKET=meetapp-dev
STORAGE_REGION=us-east-1

# ---------- Email: Mailpit (fake inbox, nothing is really sent) ----------
# The app sends email to this port; read it at http://127.0.0.1:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ---------- Optional (leave empty to turn off) ----------
# Error tracking with Sentry's free plan. Empty = off.
SENTRY_DSN=
# Where to send traces and logs (the monitoring profile uses http://127.0.0.1:4318). Empty = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
